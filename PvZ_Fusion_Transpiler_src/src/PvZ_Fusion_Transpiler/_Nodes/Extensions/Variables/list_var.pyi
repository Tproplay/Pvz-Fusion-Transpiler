from typing import Any, Generic, Iterable, Optional, Tuple, TypeVar, Union, overload

T = TypeVar("T")

class ListOperation:
    node: Any
    def __enter__(self) -> ListOperation: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
    @property
    def OnSuccess(self) -> Any: ...
    @property
    def OnComplete(self) -> Any: ...
    @property
    def Complete(self) -> Any: ...
    @property
    def complete(self) -> Any: ...
    @property
    def Failed(self) -> Any: ...
    @property
    def failed(self) -> Any: ...
    @property
    def OnFailed(self) -> Any: ...

class List(Generic[T]):
    list_port: Any
    @overload
    def __init__(self, initial: Optional[Iterable[T]] = None, name: Optional[str] = None) -> None: ...
    @overload
    def __init__(self, initial: Any = None, name: Optional[str] = None, element_type: Any = None) -> None: ...
    @property
    def Count(self) -> Any: ...
    @property
    def count(self) -> Any: ...
    def Add(self, item: Union[T, Any]) -> ListOperation: ...
    def add(self, item: Union[T, Any]) -> ListOperation: ...
    def append(self, item: Union[T, Any]) -> ListOperation: ...
    def Insert(self, index: Any, item: Union[T, Any]) -> ListOperation: ...
    def insert(self, index: Any, item: Union[T, Any]) -> ListOperation: ...
    def Replace(self, index: Any, item: Union[T, Any]) -> ListOperation: ...
    def replace(self, index: Any, item: Union[T, Any]) -> ListOperation: ...
    def __getitem__(self, index: Any) -> Any: ...
    def __setitem__(self, index: Any, item: Union[T, Any]) -> None: ...
    def get_item(self, index: Any) -> Any: ...
    def Get(self, index: Any) -> Any: ...
    def TryGetValue(self, index: Any) -> Tuple[Any, Any]: ...
    def try_get_value(self, index: Any) -> Tuple[Any, Any]: ...
    def IndexOf(self, item: Union[T, Any]) -> Any: ...
    def index_of(self, item: Union[T, Any]) -> Any: ...
    def find_index(self, item: Union[T, Any]) -> Any: ...
    def Contains(self, item: Union[T, Any]) -> Any: ...
    def contains(self, item: Union[T, Any]) -> Any: ...
    def TryFindIndex(self, item: Union[T, Any]) -> Tuple[Any, Any]: ...
    def try_find_index(self, item: Union[T, Any]) -> Tuple[Any, Any]: ...
    def RemoveAt(self, index: Any) -> ListOperation: ...
    def remove_at(self, index: Any) -> ListOperation: ...
    def Clear(self) -> ListOperation: ...
    def clear(self) -> ListOperation: ...
    def CopyTo(self, target: Any) -> ListOperation: ...
    def copy_to(self, target: Any) -> ListOperation: ...
    def Clone(self, name: Optional[str] = None) -> List[T]: ...
    def clone(self, name: Optional[str] = None) -> List[T]: ...
    def __iadd__(self, other: Any) -> List[T]: ...

class ForEach(Generic[T]):
    def __init__(self, target_list: Any) -> None: ...
    def __enter__(self) -> Any: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
    @property
    def index(self) -> Any: ...
    @property
    def on_complete(self) -> Any: ...
    @property
    def Complete(self) -> Any: ...

IntList = List[int]
FloatList = List[float]
BoolList = List[bool]
StringList = List[str]
ObjectList = List[Any]
PlantTypeListVar = List[Any]
ZombieTypeListVar = List[Any]
